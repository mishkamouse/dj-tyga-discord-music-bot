DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: set for instant command registration to one guild during development.
# Leave blank to register commands globally (can take up to an hour to propagate).
DISCORD_GUILD_ID=

YTDLP_PATH=yt-dlp
# In docker-compose this is overridden to http://pot-provider:4416
YTDLP_POT_PROVIDER_URL=http://127.0.0.1:4416
# Leave blank to let yt-dlp pick Innertube player clients itself (recommended; it tunes
# this against YouTube's changes far more often than we would). Only set this if you have
# a specific reason to override it.
YTDLP_PLAYER_CLIENTS=
# Optional network proxy for yt-dlp. In docker-compose this is overridden to
# socks5://warp:1080 automatically. Leave blank for local dev.
YTDLP_PROXY_URL=
# Optional proxy for the audio download step (a separate request from yt-dlp's own). In
# docker-compose this is overridden to http://warp:8080 automatically. Leave blank
# wherever YTDLP_PROXY_URL is also blank.
AUDIO_PROXY_URL=

# Milliseconds of an empty queue before the bot leaves the voice channel.
QUEUE_IDLE_TIMEOUT_MS=300000
# Milliseconds a 24/7-mode (/247) channel can sit with no one else in it before the bot
# gives up and disconnects anyway. Default 1 hour.
ALONE_TIMEOUT_MS=3600000

# --- Natural-language /ask command (optional; leave STRANDS_AGENT_URL blank to disable) ---

# In docker-compose this is overridden to http://strands-agent:8000
STRANDS_AGENT_URL=http://127.0.0.1:8000
# Port the bot's internal queue API listens on (only the strands-agent sidecar should ever
# reach this; it's never published to the host).
INTERNAL_API_PORT=8100

# anthropic (default), bedrock, or ollama; see agent/model.py. Only anthropic needs
# ANTHROPIC_API_KEY; bedrock/ollama need STRANDS_MODEL_ID set explicitly.
STRANDS_MODEL_PROVIDER=anthropic
# Haiku is Anthropic's cheapest current tier, plenty for this bounded queue-management
# tool set. Bump to a bigger model only if you actually need it.
STRANDS_MODEL_ID=claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=
# Only needed if your API key is "identity-linked" / scoped to multiple workspaces (you'll
# see an error mentioning anthropic-workspace-id if so). Leave blank otherwise.
ANTHROPIC_WORKSPACE_ID=

# What /radio plays when no topic is given. Just a starting point; change any time.
RADIO_DEFAULT_QUERY="Kanye West"
